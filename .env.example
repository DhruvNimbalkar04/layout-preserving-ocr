DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_ALL_ORIGINS=False
DJANGO_SERVE_MEDIA=False
DJANGO_UPLOAD_MAX_FILE_SIZE=20971520

# OCR provider: paddle | ocrspace | gemini | none.
# Empty = use PaddleOCR when installed (requirements-ocr-local.txt), else none.
OCR_BACKEND=
# Free key from https://ocr.space/ocrapi/freekey (25k pages/month, 1 MB/page).
OCRSPACE_API_KEY=
# Optional: use Google Gemini instead of OCR.space.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
